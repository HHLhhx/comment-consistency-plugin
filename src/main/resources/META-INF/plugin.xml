<!-- Plugin Configuration File. Read more:
https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin
    versions. -->
    <id>com.github.HHLhhx.comment-consistency-plugin</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines:
    https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Comment-Consistency</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor
            email="923511708@qq.com"
            url="https://github.com/HHLhhx">
        HHLhhx
    </vendor>

    <version>2.0.1</version>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines:
    https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <p>Comment Consistency is an in-editor assistant that keeps Java comments aligned with implementation logic in real time.</p>
        <p>This project aims to implement an out-of-the-box tool for developer workflows.</p>
        <h4>FEATURES:</h4>
        <ul>
            <li>Actively detect semantic inconsistencies between comments and implementation logic during code writing</li>
            <li>Integrate large language models to provide intelligent fixes for annotation consistency issues</li>
            <li>Ensure the quality of software documentation from the source and reduce the risk of comments and code deviations</li>
            <li>Improve team development efficiency and readability for subsequent maintenance</li>
        </ul>
        <p><strong>support: </strong>for feedback questions go to <a href="https://github.com/HHLhhx/comment-consistency-plugin/issues">GitHub Issues</a>。</p>
    ]]></description>

    <change-notes><![CDATA[
        <h3>v2.0.1 (2026-03-31)</h3>
        <ul>
            <li>Refactor the underlying automatic update and method state refresh logic to improve performance and reduce the possibility of UI freezes</li>
        </ul>

        <h3>v1.2.0 (2026-03-24)</h3>
        <ul>
            <li>Lowered the minimum supported IDEA version to 2022.3 (build 223) and aligned runtime compatibility with JDK 17</li>
        </ul>

        <h3>v1.1.1 (2026-03-23)</h3>
        <ul>
            <li>Updated login registration capabilities to improve the security of private data transmission</li>
        </ul>

        <h3>v1.1.0 (2026-03-20)</h3>
        <ul>
            <li>Publish the first version</li>
        </ul>
    ]]></change-notes>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.nju.comment.PluginStartupActivity"/>
        <toolWindow id="Comment Consistency"
                    factoryClass="com.nju.comment.toolwindow.MainToolWindowFactory"
                    anchor="right"
                    icon="/icons/toolWindow.svg"
                    secondary="true"/>
        <notificationGroup id="Comment Consistency"
                           displayType="BALLOON"
                           isLogByDefault="true"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="com.nju.comment.provider.CachedCommentGutterIconProvider"/>
    </extensions>

    <actions>
        <action id="CommentGenerator.GenerateFromMethod"
                class="com.nju.comment.action.GenerateCommentOnMethodAction"
                text="Generate Comment For This Method"
                description="Generate method comment by backend">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut first-keystroke="ctrl alt G" keymap="$default"/>
        </action>
        <action id="CommentGenerator.UpdateFromMethod"
                class="com.nju.comment.action.UpdateCommentOnMethodAction"
                text="Update Comment For This Method"
                description="Update method comment by backend">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut first-keystroke="ctrl alt U" keymap="$default"/>
        </action>
        <action id="CommentGenerator.UpdateFromFile"
                class="com.nju.comment.action.UpdateCommentOnFileAction"
                text="Update All Comments in This File"
                description="Update all method comments in current file by backend">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut first-keystroke="ctrl shift alt F" keymap="$default"/>
        </action>
    </actions>
</idea-plugin>
